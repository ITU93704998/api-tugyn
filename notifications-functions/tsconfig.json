{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "..",
    "outDir": "lib",
    "strict": true,
    "noEmitOnError": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "firebase-admin/*": ["node_modules/firebase-admin/lib/*"] }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["lib", "node_modules"]
}
