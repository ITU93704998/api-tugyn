# Modelo das variáveis da API (Vercel). SÓ OS NOMES: nunca coloque valores aqui.
# Os valores reais ficam na Vercel (Settings > Environment Variables). Para recriar o .env.local:
#   npx.cmd vercel env pull .env.local
# O .env de verdade NÃO vai para o Git (está no .gitignore).

# ─── Firebase Admin (Google Cloud > IAM > Contas de serviço > Chaves) ──────────
# Use FIREBASE_SERVICE_ACCOUNT (JSON inteiro) OU o trio abaixo.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Cloudinary (uma conta por tipo de mídia; painel do Cloudinary > API Keys) ─
CLOUDINARY_NAME_USUARIOS=
CLOUDINARY_KEY_USUARIOS=
CLOUDINARY_SECRET_USUARIOS=
CLOUDINARY_NAME_ARENAS=
CLOUDINARY_KEY_ARENAS=
CLOUDINARY_SECRET_ARENAS=
CLOUDINARY_NAME_TIMES=
CLOUDINARY_KEY_TIMES=
CLOUDINARY_SECRET_TIMES=
CLOUDINARY_NAME_ANUNCIOS=
CLOUDINARY_KEY_ANUNCIOS=
CLOUDINARY_SECRET_ANUNCIOS=

# ─── Limite de requisições (Upstash > banco Redis > REST API) ──────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Rotinas agendadas (cron da Vercel). Segredo gerado por você. ─────────────
CRON_SECRET=

# ─── Push (Expo > Account settings > Access tokens) ───────────────────────────
EXPO_ACCESS_TOKEN=

# ─── Live Activities (iPhone) ─────────────────────────────────────────────────
LIVE_ACTIVITIES_ENABLED=
LIVE_ACTIVITY_APNS_ENV=

# ─── Segurança / CORS ─────────────────────────────────────────────────────────
# App Check obrigatório (true/false).
APP_CHECK_ENFORCE=
# Origens permitidas, separadas por vírgula (painel e site).
PANEL_ORIGINS=
SITE_ORIGINS=
# Sal para anonimizar IP nas métricas de anúncios. Segredo gerado por você.
ADS_IP_SALT=
